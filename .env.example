# Backend
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Worker
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# JWT Secret (used for auth tokens)
JWT_SECRET=your-jwt-secret-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:5000/api/slack/callback

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
# Dev Login (DEV-ONLY: set to 'true' to enable /auth/dev-login for testing without Google OAuth)
DEV_LOGIN=false
